{
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.bab-digital.com/",
      "permanent": false
    },
    {
      "source": "/demos/dentiste.html",
      "destination": "/exemples/cabinet-dentaire.html",
      "permanent": false
    },
    {
      "source": "/demos/immobilier.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/demos/salle-de-sport.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/questionnaire",
      "destination": "https://www.bab-digital.com/questionnaire/",
      "permanent": false
    },
    {
      "source": "/questionnaire/",
      "destination": "https://www.bab-digital.com/questionnaire/",
      "permanent": false
    },
    {
      "source": "/questionnaire/:path*",
      "destination": "https://www.bab-digital.com/questionnaire/",
      "permanent": false
    },
    {
      "source": "/portes",
      "destination": "/portes/",
      "permanent": false
    },
    {
      "source": "/portes/tarifs",
      "destination": "/portes/tarifs/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/espace/:code([a-z0-9]{8,32})",
      "destination": "/espace/index.html"
    },
    {
      "source": "/portes/exemples/:path*",
      "destination": "/exemples/:path*"
    },
    {
      "source": "/portes/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/portes/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/portes/logo-icon.svg",
      "destination": "/logo-icon.svg"
    }
  ],
  "headers": [
    {
      "source": "/espace/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}